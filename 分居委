#!/usr/bin/bash

set -uo pipefail

DIR_MODE=0
FILE=""
DISTRICT=""
FILTER_STREET=""
LOG_LEVEL="INFO"
args=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        -D)
            DIR_MODE=1
            shift
            ;;
        -l|--log-level)
            if [[ $# -lt 2 ]]; then
                echo "❌ 缺少日志等级参数！"
                echo "可选值: DEBUG、INFO、ERROR"
                exit 1
            fi
            LOG_LEVEL="$2"
            shift 2
            ;;
        *)
            args+=("$1")
            shift
            ;;
    esac
done

if [[ ${#args[@]} -ne 3 ]]; then
    echo "❌ 参数缺失！"
    echo "用法: $0 [-D] [-l DEBUG|INFO|ERROR] <文件或目录> <区> <街道>"
    exit 1
fi

FILE="${args[0]}"
DISTRICT="${args[1]}"
FILTER_STREET="${args[2]}"

process_file() {
    local excel_path="$1"
    local filename=$(basename "$excel_path")
    if [[ "$LOG_LEVEL" != "ERROR" ]]; then
        echo ""
        echo "📄 正在处理：$filename"
        echo ""
    fi
    # 筛选街道
    local filtered_excel=$(bun --cwd packages/cli filter_street.js "$excel_path" "$DISTRICT" "$FILTER_STREET" -o)
    # 匹配居委写入表格
    bun --cwd packages/cli index.js "$filtered_excel" --log-level "$LOG_LEVEL"
}

if [[ $DIR_MODE -eq 1 ]]; then
    if [[ ! -d "$FILE" ]]; then
        echo "❌ 路径 '$FILE' 不是一个有效的目录！"
        exit 1
    fi

    files=("$FILE"/*)
    # 检查目录是否为空
    if [[ ${#files[@]} -eq 0 || ! -e "${files[0]}" ]]; then
        echo "❌ 目录 '$FILE' 为空！"
        exit 0
    fi

    for file in "${files[@]}"; do
        filename=$(basename "$file")
        if [[ ! -f "$file" || "$filename" != *.xlsx ]]; then
            echo "⏭️  跳过文件: $filename"
            continue
        fi

        # 跳过Office临时文件
        if [[ "$filename" == '~$'* ]]; then
            echo "⏭️  跳过Office临时文件: $filename"
            continue
        fi

        # 只处理文件名包含区名称的原始名单，跳过已按街道生成的文件
        if [[ "$filename" != *"$DISTRICT"* ]]; then
            echo "⏭️  跳过已筛选镇街文件: $filename"
            continue
        fi
        process_file "$file"
    done
else
    if [[ ! -f "$FILE" ]]; then
        echo "❌ 文件 '$FILE' 不存在！"
        exit 1
    fi
    process_file "$FILE"
fi
